# ---------------------------------------------------------------------------
# IMPORTANT: Markdown is intentionally NOT ignored anywhere in this repo.
# Root entry points, durable docs/ records and skills/ teaching guidance are required
# sources for the website and its authoring workflow.
# They must stay committed. Do not add blanket *.md patterns here.
# Also kept: public/learn-assets/ (loaded at runtime by lesson-labs),
# src/learn/data/generated/ (imported by the build) and durable docs JSON.
# Keep content/, src/articles/generated/ and all intentional public assets too.
# Scope local authoring artifacts to their owner; keep substantive prepared content.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build output / bundler cache
/dist/
/dist-*/
/.vite/
/.wrangler/
/apps/*/dist/
/apps/*/.vite/
/apps/*/.next/
/apps/*/build/

# One-off working material (includes a bundled Python venv under
# scratch/lesson-tools and hundreds of MB of capture logs)
/scratch/
/scratch_*.py
/tmp_*/
/tmp_*.py

# Completed authoring workspaces are local history, not deployment inputs.
# Keep the small restart indexes and the explicitly unfinished content packets.
# Canonical lessons/assets, docs/teaching/drafts, topic-notes and skills stay tracked.
/docs/teaching/classical-ml-reading-flow/*
!/docs/teaching/classical-ml-reading-flow/*.md
!/docs/teaching/classical-ml-reading-flow/scope.json
!/docs/teaching/classical-ml-reading-flow/t-sne-umap-manifold-learning/
!/docs/teaching/classical-ml-reading-flow/non-negative-matrix-factorization-nmf/
!/docs/teaching/classical-ml-reading-flow/feature-scaling-encoding-imputation/
!/docs/teaching/classical-ml-reading-flow/cross-validation-hyperparameter-tuning/
!/docs/teaching/classical-ml-reading-flow/regularization-l1-l2-elastic-net-dropout/
/docs/teaching/math-foundations-reading-flow/*
!/docs/teaching/math-foundations-reading-flow/*.md
!/docs/teaching/math-foundations-reading-flow/scope.json
!/docs/teaching/math-foundations-reading-flow/entropy-cross-entropy-kl-divergence/
!/docs/teaching/math-foundations-reading-flow/mutual-information-information-bottleneck/
!/docs/teaching/math-foundations-reading-flow/rate-distortion-theory/
!/docs/teaching/math-foundations-reading-flow/f-divergences-integral-probability-metrics/
!/docs/teaching/math-foundations-reading-flow/dynamical-systems-theory-chaos/
!/docs/teaching/math-foundations-reading-flow/it-calculus-stochastic-differential-equations/
/docs/teaching/deep-learning-beginner/*
!/docs/teaching/deep-learning-beginner/*.md
!/docs/teaching/deep-learning-beginner/scope.json
/docs/teaching/deep-learning-completion/*
!/docs/teaching/deep-learning-completion/*.md
/docs/teaching/llm-architecture-training/*
!/docs/teaching/llm-architecture-training/*.md
!/docs/teaching/llm-architecture-training/*scope*.json

# Local lesson-authoring artifacts, not website or prepared-content sources.
# Retained locally for historical inspection; never match src/, public/, scripts/,
# skills/, topic notes, manuscripts or visual specifications outside these copies.
/docs/teaching/**/*frozen*/
/docs/teaching/**/copies/
/docs/teaching/**/snapshot/
/docs/teaching/**/snapshots/
/docs/teaching/**/*-snapshot*/
/docs/teaching/**/*-before-*/
/docs/teaching/**/original/
/docs/teaching/**/node_modules/
/docs/teaching/**/site-packages/
/docs/teaching/**/packages/
/docs/teaching/**/optional-*-packages/
/docs/teaching/**/production/
/docs/teaching/**/production-*/
/docs/teaching/**/prototype-dist/
/docs/teaching/**/runtime-preview/assets/
/docs/teaching/**/playwright-report/
/docs/teaching/**/test-results/
/docs/teaching/**/screenshots/
/docs/teaching/**/captures/

# One-off authoring/review runners. Reusable project checks live in scripts/;
# explained lesson programmes and their data remain trackable.
/docs/teaching/**/check-*.py
/docs/teaching/**/check-*.cjs
/docs/teaching/**/check-*.mjs
/docs/teaching/**/verify-*.py
/docs/teaching/**/verify-*.cjs
/docs/teaching/**/verify-*.mjs
/docs/teaching/**/freeze-*.py
/docs/teaching/**/freeze-*.cjs
/docs/teaching/**/freeze-*.mjs
/docs/teaching/**/capture-*.py
/docs/teaching/**/capture-*.cjs
/docs/teaching/**/capture-*.mjs
/docs/teaching/**/patch-*.py
/docs/teaching/**/install-*.py
/docs/teaching/**/assemble-*.py
/docs/teaching/**/prepare-*.py

# ML training artifacts written into the working tree
/catboost_info/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Headless-browser review output (scripts/*.cjs playwright runs)
/playwright-report/
/test-results/
/apps/*/playwright-report/
/apps/*/test-results/

# Logs
/*.log
/logs/
/apps/*/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
!.env.*.example

# Machine-local agent + editor settings (.claude/launch.json is committed)
.claude/settings.local.json
.claude/local/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Stray zero-byte file left by a shell redirect
/npm
